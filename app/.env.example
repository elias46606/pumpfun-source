# All services default to localhost. No production keys are required.
PORT=3001
BACKEND_URL=http://127.0.0.1:3001
# FIXTURES_FILE=/absolute/path/to/sanitized-fixtures.json
# Optional server-owned confirmed-payout facts; absent preserves fixture/501.
# No live payout service or credentials. See packages/backend/PAYOUTS.md.
# PAYOUTS_FILE=/absolute/path/to/local-payouts.json
# Optional server-owned local ban list; absent preserves fixture/501.
# No moderation service or credentials. See packages/backend/MODERATION.md.
# MODERATION_BANS_FILE=/absolute/path/to/local-bans.json
# Server-only Solana mainnet RPC for /portfolio. Unset = live reads disabled (503).
# To enable explicitly, set a public HTTPS mainnet provider; never expose its URL
# in NEXT_PUBLIC_* variables. Example:
# SOLANA_RPC_URL=https://api.mainnet.solana.com
# Future integrations; leave disabled until implemented and tested.
# DATABASE_URL=
# REDIS_URL=
# PUMP_API_KEY=
